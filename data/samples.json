, "chatting"], [4.26, 4.52, "with"], [4.52, 5.04, "strangers"], [5.04, 5.34, "in"], [5.34, 5.74, "English."], [6.06, 6.66, "But"], [6.66, 6.96, "these"], [6.96, 7.3, "days,"], [7.52, 7.7, "it's"], [7.7, 8.02, "become"], [8.02, 8.24, "one"], [8.24, 8.36, "of"], [8.36, 8.54, "my"], [8.54, 8.98, "favorite"], [8.98, 9.42, "parts"], [9.42, 9.58, "of"], [9.58, 10.08, "traveling."], [10.56, 11.14, "On"], [11.14, 11.26, "a"], [11.26, 11.64, "recent"], [11.64, 11.9, "trip"], [11.9, 12.1, "to"], [12.1, 12.64, "Taipei,"], [13.12, 13.42, "I"], [13.42, 13.66, "ended"], [13.66, 13.9, "up"], [13.9, 14.28, "talking"], [14.28, 14.54, "with"], [14.54, 14.66, "a"], [14.66, 15.08, "cafe"], [15.08, 15.52, "owner"], [15.52, 15.8, "for"], [15.8, 16.18, "almost"], [16.18, 16.42, "an"], [16.42, 16.82, "hour"], [16.82, 17.22, "about"], [17.22, 17.44, "the"], [17.44, 17.94, "challenges"], [17.94, 18.26, "of"], [18.26, 18.5, "running"], [18.5, 18.7, "a"], [18.7, 19.02, "small"], [19.02, 19.52, "business"], [19.52, 19.94, "abroad."], [20.38, 20.98, "She"], [20.98, 21.2, "was"], [21.2, 21.78, "incredibly"], [21.78, 22.3, "candid"], [22.3, 22.66, "about"], [22.66, 22.92, "her"], [22.92, 23.46, "failures,"], [23.46, 24.24, "and"], [24.24, 24.44, "that"], [24.44, 25.22, "conversation"], [25.22, 25.96, "genuinely"], [25.96, 26.66, "changed"], [26.66, 26.86, "the"], [26.86, 27.04, "way"], [27.04, 27.2, "I"], [27.2, 27.46, "think"], [27.46, 27.74, "about"], [27.74, 28.12, "taking"], [28.12, 28.66, "risks"], [28.66, 28.92, "in"], [28.92, 29.12, "my"], [29.12, 29.38, "own"], [29.38, 29.86, "career."], [30.28, 30.32, "Thank"], [30.32, 30.34, "you."]]}, "listen": {"text": "Honestly, the first year was brutal. I underestimated how much paperwork it takes to import beans, and I nearly ran out of money twice. But looking back, those setbacks forced me to get creative. I started hosting small tasting events, and that's what really put us on the map. Have you ever thought about starting something of your own?"