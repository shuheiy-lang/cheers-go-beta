4.14, 4.6, "chatting"], [4.6, 4.84, "with"], [4.84, 5.38, "strangers"], [5.38, 5.66, "in"], [5.66, 6.08, "English."], [6.36, 6.84, "But"], [6.84, 7.14, "these"], [7.14, 7.42, "days,"], [7.48, 8.14, "it's"], [8.14, 8.44, "become"], [8.44, 8.64, "one"], [8.64, 8.74, "of"], [8.74, 8.88, "my"], [8.88, 9.22, "favorite"], [9.22, 9.6, "parts"], [9.6, 9.74, "of"], [9.74, 10.16, "traveling."], [10.74, 11.34, "On"], [11.34, 11.44, "a"], [11.44, 11.74, "recent"], [11.74, 11.94, "trip"], [11.94, 12.12, "to"], [12.12, 12.52, "Taipei,"], [12.8, 13.1, "I"], [13.1, 13.32, "ended"], [13.32, 13.5, "up"], [13.5, 13.84, "talking"], [13.84, 14.1, "with"], [14.1, 14.24, "a"], [14.24, 14.6, "coffee"], [14.6, 14.9, "owner"], [14.9, 15.16, "for"], [15.16, 15.66, "almost"], [15.66, 15.92, "an"], [15.92, 16.42, "hour"], [16.42, 16.92, "about"], [16.92, 17.42, "the"], [17.42, 17.9, "challenges"], [17.9, 18.22, "of"], [18.22, 18.46, "running"], [18.46, 18.64, "a"], [18.64, 18.88, "small"], [18.88, 19.32, "business"], [19.32, 19.68, "abroad."], [20.12, 20.72, "She"], [20.72, 20.92, "was"], [20.92, 21.6, "incredibly"], [21.6, 22.12, "candid"], [22.12, 22.56, "about"], [22.56, 23.02, "her"], [23.02, 23.6, "failures."], [23.86, 24.42, "And"], [24.42, 24.62, "that"], [24.62, 25.3, "conversation"], [25.3, 26.32, "genuinely"], [26.32, 26.98, "changed"], [26.98, 27.12, "the"], [27.12, 27.3, "way"], [27.3, 27.54, "I"], [27.54, 27.82, "think"], [27.82, 28.08, "about"], [28.08, 28.42, "taking"], [28.42, 28.88, "risks"], [28.88, 29.1, "in"], [29.1, 29.22, "my"], [29.22, 29.4, "own"], [29.4, 29.76, "career."], [30.0, 30.0, "Thank"], [30.0, 30.32, "you."]]}, "listen": {"text": "Honestly, the first year was brutal. I underestimated how much paperwork it takes to import beans, and I nearly ran out of money twice. But looking back, those setbacks forced me to get creative. I started hosting small tasting events, and that's what really put us on the map. Have you ever thought about starting something of your own